# trainer.env — per-user paths + settings the scripts source.
#
# Copy this to `trainer.env` and edit it for your account, OR let `oceanctl setup`
# generate it for you. The scripts locate it automatically when run from the repo;
# SLURM jobs receive it via `sbatch --export=ALL,TRAINER_ENV=/abs/path/to/trainer.env`.
#
# Tip: run `echo $HOME` on Unity to get your real home path, then substitute it below.

TRAINER_ROOT="$HOME/ocean_detect/trainer"
PROJECT_DIR="$TRAINER_ROOT/sam2-vidio-annotation"
VENV_DIR="$TRAINER_ROOT/trainerenv"
INSTALL_ROOT="$PROJECT_DIR"
QUEUE_DIR="$HOME/annotated-video/queue"
RUNS_DIR="$PROJECT_DIR/runs"

# rclone remote + Google Drive layout (read-only)
RCLONE_REMOTE="gdrive"
DRIVE_QUEUE="DeepSea_ObjectDetection/rclone/queue"

# Roboflow (used by train.py / train_tide.slurm). Prefer an env var over hardcoding.
# export ROBOFLOW_API_KEY="..."
